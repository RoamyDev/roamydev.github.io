---
import { ui, type UILanguage } from '../i18n/ui';

interface Props {
  lang: UILanguage;
}

const { lang } = Astro.props;
const t = (key: keyof typeof ui.en) => ui[lang][key] || ui.en[key];

---

<footer class="border-t border-mono-800 bg-mono-950">
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
      {/* Logo & Copyright */}
      <div class="flex flex-col items-center gap-2 sm:items-start">
        <span class="font-mono text-lg font-bold text-mono-50">Roamy</span>
        <p class="text-xs text-mono-500">
          {t('footer.copyright')}
        </p>
      </div>

      {/* Links */}
      <div class="flex items-center gap-6">
        <a
          href="https://github.com/RoamyDev"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-mono-400 transition-colors hover:text-mono-50"
        >
          GitHub
        </a>
      </div>
    </div>
  </div>
</footer>
