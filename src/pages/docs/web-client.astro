---
import DocsLayout from '../../layouts/DocsLayout.astro';
const lang = 'en';

const codeArch = `index.html          # Entry HTML
src/
  main.js           # App entry — terminal init, connection UI, event wiring
  client.js         # RoamyClient — WebSocket transport, Protobuf encode/decode
  proto.js          # Generated Protobuf bindings (via pbjs)
  semantic-engine/   # Client-side semantic UI engine`;

const codeDev = `cd roamy-web

# Install dependencies
npm install

# Start dev server (http://localhost:3000)
npm run dev

# Build for production
npm run build

# Regenerate Protobuf bindings (after proto changes)
npm run proto`;

const codeRoamyClient = `import { RoamyClient } from './client.js';

const client = new RoamyClient();

// Connect to sessiond
await client.connect('ws://127.0.0.1:9800');

// Optional: authenticate
client.sendDeviceAuth(deviceId, deviceToken);

// Create a new session
client.createSession(120, 30);

// Join existing session
client.joinSession(sessionId, 120, 30);

// Send keyboard input
client.sendInput(sessionId, 'ls -la\\n');

// Resize terminal
client.sendResize(sessionId, 80, 24);

// Leave session
client.leaveSession(sessionId);

// Destroy session
client.destroySession(sessionId);

// List sessions
client.listSessions();

// Disconnect
client.disconnect();`;
---

<DocsLayout lang={lang}>
  <h1 class="font-mono text-3xl font-bold text-mono-50">Web Client</h1>
  <p class="mt-4 text-mono-400 leading-relaxed">
    <code class="text-mono-200">roamy-web</code> is a browser-based terminal client that connects to sessiond via WebSocket. It provides a full terminal experience powered by <a href="https://xtermjs.org/" class="text-mono-200 underline hover:text-mono-50">xterm.js</a> and communicates using the Protobuf wire protocol.
  </p>

  <h2 class="mt-10 font-mono text-xl font-bold text-mono-100">Architecture</h2>
  <pre class="mt-4 overflow-x-auto rounded-lg border border-mono-800 bg-mono-900/50 p-4 font-mono text-sm text-mono-300"><code set:html={codeArch} /></pre>

  <h2 class="mt-10 font-mono text-xl font-bold text-mono-100">Development</h2>
  <pre class="mt-4 overflow-x-auto rounded-lg border border-mono-800 bg-mono-900/50 p-4 font-mono text-sm text-mono-300"><code set:html={codeDev} /></pre>

  <h2 class="mt-10 font-mono text-xl font-bold text-mono-100">RoamyClient API</h2>
  <p class="mt-3 text-sm text-mono-400">
    The <code class="text-mono-200">RoamyClient</code> class extends <code class="text-mono-200">EventTarget</code> and provides a clean event-driven API:
  </p>
  <pre class="mt-4 overflow-x-auto rounded-lg border border-mono-800 bg-mono-900/50 p-4 font-mono text-sm text-mono-300"><code set:html={codeRoamyClient} /></pre>

  <h2 class="mt-10 font-mono text-xl font-bold text-mono-100">Events</h2>
  <div class="mt-4 overflow-x-auto">
    <table class="w-full text-sm text-mono-400">
      <thead><tr class="border-b border-mono-800 text-left"><th class="pb-2 pr-6 font-mono text-mono-200">Event</th><th class="pb-2 font-mono text-mono-200">Data</th></tr></thead>
      <tbody class="divide-y divide-mono-800/50">
        <tr><td class="py-2 pr-6 font-mono text-mono-100"><code>session-created</code></td><td class="py-2"><code>SessionInfo</code></td></tr>
        <tr><td class="py-2 pr-6 font-mono text-mono-100"><code>session-joined</code></td><td class="py-2" set:html={"<code>{ info, replayData }</code>"} /></td></tr>
        <tr><td class="py-2 pr-6 font-mono text-mono-100"><code>session-left</code></td><td class="py-2">&mdash;</td></tr>
        <tr><td class="py-2 pr-6 font-mono text-mono-100"><code>session-destroyed</code></td><td class="py-2">&mdash;</td></tr>
        <tr><td class="py-2 pr-6 font-mono text-mono-100"><code>session-list</code></td><td class="py-2"><code>SessionInfo[]</code></td></tr>
        <tr><td class="py-2 pr-6 font-mono text-mono-100"><code>terminal-output</code></td><td class="py-2"><code>Uint8Array</code> (raw bytes)</td></tr>
        <tr><td class="py-2 pr-6 font-mono text-mono-100"><code>cwd-changed</code></td><td class="py-2"><code>string</code> (path)</td></tr>
        <tr><td class="py-2 pr-6 font-mono text-mono-100"><code>command-started</code></td><td class="py-2" set:html={"<code>{ command_line, command_id }</code>"} /></td></tr>
        <tr><td class="py-2 pr-6 font-mono text-mono-100"><code>command-ended</code></td><td class="py-2" set:html={"<code>{ command_id, exit_code }</code>"} /></td></tr>
        <tr><td class="py-2 pr-6 font-mono text-mono-100"><code>agent-signal</code></td><td class="py-2"><code>AgentSignal</code> proto</td></tr>
        <tr><td class="py-2 pr-6 font-mono text-mono-100"><code>git-status</code></td><td class="py-2"><code>GitStatusSnapshot</code> proto</td></tr>
        <tr><td class="py-2 pr-6 font-mono text-mono-100"><code>close</code></td><td class="py-2" set:html={"<code>{ code, reason }</code>"} /></td></tr>
        <tr><td class="py-2 pr-6 font-mono text-mono-100"><code>error</code></td><td class="py-2"><code>Error</code></td></tr>
      </tbody>
    </table>
  </div>

  <h2 class="mt-10 font-mono text-xl font-bold text-mono-100">QR Code Auto-Connect</h2>
  <p class="mt-3 text-sm text-mono-400">
    When the web client is opened with URL parameters from a QR code (<code class="text-mono-200">?host=&amp;port=&amp;token=&amp;scheme=</code>), it automatically connects to the sessiond instance. This enables seamless pairing from the QR code printed by sessiond.
  </p>

  <h2 class="mt-10 font-mono text-xl font-bold text-mono-100">Auto-Reconnect</h2>
  <p class="mt-3 text-sm text-mono-400">
    On connection loss, the web client automatically attempts to reconnect with exponential backoff (1s, 2s, 4s, ... up to 30s). Reconnection state is shown in the status bar.
  </p>

  <h2 class="mt-10 font-mono text-xl font-bold text-mono-100">Dependencies</h2>
  <ul class="mt-4 list-disc space-y-1 pl-6 text-sm text-mono-400">
    <li><code class="text-mono-200">@xterm/xterm</code> 6+ &mdash; Terminal emulator</li>
    <li><code class="text-mono-200">@xterm/addon-fit</code> &mdash; Auto-resize to container</li>
    <li><code class="text-mono-200">protobufjs</code> &mdash; Protobuf encode/decode in browser</li>
  </ul>
</DocsLayout>
