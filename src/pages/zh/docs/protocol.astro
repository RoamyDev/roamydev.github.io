---
import DocsLayout from '../../../layouts/DocsLayout.astro';
const lang = 'zh';

const codeStreamTypes = `STREAM_TYPE_SESSION    = 1  // 会话生命周期消息
STREAM_TYPE_TERMINAL   = 2  // 终端 I/O
STREAM_TYPE_CONTROL    = 3  // 认证、配对、心跳
STREAM_TYPE_SEMANTIC   = 4  // Shell 事实、Agent 信号
STREAM_TYPE_GIT        = 5  // Git 状态和差异`;

const codeSessionLifecycle = `会话状态：
  RUNNING     = 1  // 活跃会话，PTY 运行中
  DETACHED    = 2  // 无客户端连接（会话持续）
  TERMINATED  = 3  // PTY 进程已退出

客户端 → 服务器：
  CreateSessionRequest   { host_id, client_id, cols, rows, shell_path }
  AttachSessionRequest   { session_ref, client_id, cols, rows, last_seen_offset }
  DetachSessionRequest   { session_ref, client_id }
  DestroySessionRequest  { session_ref }
  ListSessionsRequest    { host_id }

服务器 → 客户端：
  CreateSessionResponse  { session_info }
  AttachSessionResponse  { session_info, replay_data }
  ListSessionsResponse   sessions: [SessionInfo]`;

const codeTerminalIO = `// 服务器 → 客户端：终端输出
TerminalChunk { session_ref, data, offset, timestamp }

// 客户端 → 服务器：键盘/粘贴输入
InputEvent { session_ref, data, source_client_id, input_type }
  input_type: KEYBOARD = 1, PASTE = 2, MOUSE = 3

// 客户端 → 服务器：终端调整大小
ResizeEvent { session_ref, source_client_id, cols, rows }`;

const codeControlAuth = `// 客户端 → 服务器：设备认证
DeviceAuthRequest  { device_id, device_token, protocol_version }
DeviceAuthResponse { accepted, reject_reason, server_protocol_version }

// 服务器 → 客户端：配对信息
PairingCodeIssued  { host_id, code, expires_at, qr_data }
DevicePaired       { host_id, device_id, device_name, account_id }

// 双向：心跳
Heartbeat { timestamp }

// 服务器 → 客户端：重连提示
ReconnectHint { session_id, last_seen_offset }`;

const codeSemantic = `// Shell 集成事件
ShellFactEvent {
  cwd_changed:     { path }
  command_started: { command_line, command_id }
  command_ended:   { command_id, exit_code }
}

// AI Agent 活动信号
AgentSignal { session_id, timestamp, agent_kind, state, tool_name, raw_context }
  state: IDLE = 1, THINKING = 2, TOOL_CALLING = 3, WAITING_APPROVAL = 4, ERROR = 5`;

const codeRustDep = `# Cargo.toml
[dependencies]
roamy-protocol = { path = "../roamy-protocol" }`;

const codeJsProto = `# 在 roamy-web 中
npm run proto   # 通过 pbjs 生成 src/proto.js`;
---

<DocsLayout lang={lang}>
  <h1 class="font-mono text-3xl font-bold text-mono-50">协议</h1>
  <p class="mt-4 text-mono-400 leading-relaxed">
    Roamy 使用基于 Protobuf 的线路协议，通过 WebSocket（或 Unix 域套接字）传输。每个二进制帧都是一个 <code class="text-mono-200">Envelope</code> 消息，包含类型化负载和元数据。
  </p>

  <h2 class="mt-10 font-mono text-xl font-bold text-mono-100">Proto 定义</h2>
  <div class="mt-4 overflow-x-auto">
    <table class="w-full text-sm text-mono-400">
      <thead><tr class="border-b border-mono-800 text-left"><th class="pb-2 pr-6 font-mono text-mono-200">文件</th><th class="pb-2 font-mono text-mono-200">说明</th></tr></thead>
      <tbody class="divide-y divide-mono-800/50">
        <tr><td class="py-2 pr-6 font-mono text-mono-100"><code>envelope.proto</code></td><td class="py-2">顶层消息包装器，包含流类型、序列号和时间戳</td></tr>
        <tr><td class="py-2 pr-6 font-mono text-mono-100"><code>session.proto</code></td><td class="py-2">会话生命周期：创建、连接、断开、销毁、列表</td></tr>
        <tr><td class="py-2 pr-6 font-mono text-mono-100"><code>terminal.proto</code></td><td class="py-2">终端 I/O：输出块、键盘输入、调整大小事件</td></tr>
        <tr><td class="py-2 pr-6 font-mono text-mono-100"><code>control.proto</code></td><td class="py-2">控制：设备认证、配对、重连提示、心跳</td></tr>
        <tr><td class="py-2 pr-6 font-mono text-mono-100"><code>semantic.proto</code></td><td class="py-2">Shell 集成：目录变更、命令生命周期、Agent 信号</td></tr>
        <tr><td class="py-2 pr-6 font-mono text-mono-100"><code>git.proto</code></td><td class="py-2">Git 元数据：分支状态、文件变更、差异预览</td></tr>
      </tbody>
    </table>
  </div>

  <h2 class="mt-10 font-mono text-xl font-bold text-mono-100">信封模式</h2>
  <p class="mt-3 text-sm text-mono-400">
    所有消息都包装在 <code class="text-mono-200">Envelope</code> 中，包含：
  </p>
  <ul class="mt-2 list-disc space-y-1 pl-6 text-sm text-mono-400">
    <li><code class="text-mono-200">protocol_version</code> &mdash; 前向兼容版本（当前为 1）</li>
    <li><code class="text-mono-200">stream_type</code> &mdash; 路由用逻辑流（session、terminal、control、semantic、git）</li>
    <li><code class="text-mono-200">sequence</code> &mdash; 每连接单调递增序列号</li>
    <li><code class="text-mono-200">timestamp</code> &mdash; 消息时间戳</li>
    <li><code class="text-mono-200">payload</code> &mdash; 所有消息类型的 oneof 联合</li>
  </ul>

  <h2 class="mt-10 font-mono text-xl font-bold text-mono-100">流类型</h2>
  <pre class="mt-4 overflow-x-auto rounded-lg border border-mono-800 bg-mono-900/50 p-4 font-mono text-sm text-mono-300"><code set:html={codeStreamTypes} /></pre>

  <h2 class="mt-10 font-mono text-xl font-bold text-mono-100">会话生命周期</h2>
  <pre class="mt-4 overflow-x-auto rounded-lg border border-mono-800 bg-mono-900/50 p-4 font-mono text-sm text-mono-300"><code set:html={codeSessionLifecycle} /></pre>

  <h2 class="mt-10 font-mono text-xl font-bold text-mono-100">终端 I/O</h2>
  <pre class="mt-4 overflow-x-auto rounded-lg border border-mono-800 bg-mono-900/50 p-4 font-mono text-sm text-mono-300"><code set:html={codeTerminalIO} /></pre>

  <h2 class="mt-10 font-mono text-xl font-bold text-mono-100">控制与认证</h2>
  <pre class="mt-4 overflow-x-auto rounded-lg border border-mono-800 bg-mono-900/50 p-4 font-mono text-sm text-mono-300"><code set:html={codeControlAuth} /></pre>

  <h2 class="mt-10 font-mono text-xl font-bold text-mono-100">语义事件</h2>
  <pre class="mt-4 overflow-x-auto rounded-lg border border-mono-800 bg-mono-900/50 p-4 font-mono text-sm text-mono-300"><code set:html={codeSemantic} /></pre>

  <h2 class="mt-10 font-mono text-xl font-bold text-mono-100">设计原则</h2>
  <ul class="mt-4 list-disc space-y-1 pl-6 text-sm text-mono-400">
    <li><strong class="text-mono-200">语言无关</strong> &mdash; Protobuf 确保任何语言的客户端都能实现协议</li>
    <li><strong class="text-mono-200">稳定线路格式</strong> &mdash; 破坏性变更需要显式版本升级</li>
    <li><strong class="text-mono-200">信封复用</strong> &mdash; 所有流共用单个 WebSocket 连接</li>
    <li><strong class="text-mono-200">重放支持</strong> &mdash; 单调递增字节偏移量支持重连时 scrollback 重放</li>
  </ul>

  <h2 class="mt-10 font-mono text-xl font-bold text-mono-100">在 Rust 中使用</h2>
  <pre class="mt-4 overflow-x-auto rounded-lg border border-mono-800 bg-mono-900/50 p-4 font-mono text-sm text-mono-300"><code set:html={codeRustDep} /></pre>
  <p class="mt-3 text-sm text-mono-400">
    Rust 类型通过 <code class="text-mono-200">prost</code> 在 <code class="text-mono-200">build.rs</code> 中自动生成。从 <code class="text-mono-200">roamy_protocol::gen</code> 导入使用。
  </p>

  <h2 class="mt-10 font-mono text-xl font-bold text-mono-100">在 JavaScript 中使用</h2>
  <pre class="mt-4 overflow-x-auto rounded-lg border border-mono-800 bg-mono-900/50 p-4 font-mono text-sm text-mono-300"><code set:html={codeJsProto} /></pre>
  <p class="mt-3 text-sm text-mono-400">
    生成的模块提供静态方法 <code class="text-mono-200">Envelope.create()</code>、<code class="text-mono-200">Envelope.encode()</code> 和 <code class="text-mono-200">Envelope.decode()</code>，适用于浏览器和 Node.js。
  </p>
</DocsLayout>
