---
import Layout from '../../layouts/Layout.astro';

const lang = 'zh';
---

<Layout lang={lang}>
  <main class="flex-1 flex items-center justify-center min-h-screen">
    <section class="text-center px-4">
      <h1 class="font-mono text-5xl font-bold tracking-tight text-mono-50 sm:text-7xl">
        Roamy
      </h1>
      <p class="mx-auto mt-6 max-w-xl text-lg text-mono-400">
        全新产品，即将发布。
      </p>
      <div class="mt-12">
        <span class="inline-block rounded-full border border-mono-700 bg-mono-900/50 px-6 py-3 text-sm text-mono-300">
          Coming Soon
        </span>
      </div>
      <p class="mt-16 text-sm text-mono-600">
        roamy.dev
      </p>
    </section>
  </main>
</Layout>
