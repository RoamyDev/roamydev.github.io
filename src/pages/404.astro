---
import Layout from '../layouts/Layout.astro';

const lang = 'en';
---

<Layout lang={lang}>
  <main class="flex flex-1 items-center justify-center">
    <div class="text-center">
      <h1 class="font-mono text-6xl font-bold text-mono-50">404</h1>
      <p class="mt-4 text-mono-400">Page not found</p>
      <a
        href="/"
        class="mt-8 inline-block rounded-full border border-mono-700 bg-mono-900 px-6 py-3 text-sm font-medium text-mono-50 transition-colors hover:bg-mono-800"
      >
        Go Home
      </a>
    </div>
  </main>
</Layout>
